{
  "name": "Hydrous Skin",
  "description": "You slowly regain thirst when in water, but loose it faster when not.",
  "type": "origins:multiple",
  "hydrateinwater": {
    "type": "origins:action_over_time",
    "entity_action": {
      "type": "originstoughasnails:hydrate",
      "hydration": 2,
      "thirst": 2
    },
    "interval": 2000,
    "condition": {
      "type": "origins:fluid_height",
      "fluid": "minecraft:water",
      "comparison": ">=",
      "compare_to": 0.5
    }
  },
  "dryoutwhennot": {
    "type": "originstoughasnails:modify_thirst_exhaustion",
    "modifier": {
      "id": "originstan:higher_thirstifnotinwater",
      "operation": "multiply_base_additive",
      "amount": 1.6
    },
    "condition": {
      "type": "origins:fluid_height",
      "fluid": "minecraft:water",
      "comparison": "<",
      "compare_to": 0.5
    }
  }
}